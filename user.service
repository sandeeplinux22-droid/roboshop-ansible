[Unit]
Description=User Service
After=network-online.target

[Service]
User=roboshop
Environment=REDIS_URL="redis://{{ redis.sandeeplinux22.store }}:6379"
Environment=MONGO_URL="mongodb://{{ mongodb.sandeeplinux22.store }}:27017/users"
ExecStart=/bin/node /app/server.js
SyslogIdentifier=user
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target